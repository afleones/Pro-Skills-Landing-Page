      </div>
    </div>
  </div>
</section>

<style>
  .schedule { background: var(--black); }

  .section-header { text-align: center; max-width: 640px; margin: 0 auto 56px; }
  .section-desc { color: rgba(0,0,0,0.5); font-size: 1rem; margin-top: 14px; line-height: 1.7; }

  .schedule-tabs {
    display: flex;
    gap: 6px;
    margin-bottom: 28px;
    background: var(--black-card);
    border: 1px solid var(--black-border);
    padding: 6px;
    border-radius: 50px;
    width: fit-content;
  }

  .tab-btn {
    padding: 10px 28px;
    border-radius: 50px;
    font-size: 0.88rem;
    font-weight: 700;
    color: rgba(0,0,0,0.5);
    background: transparent;
    transition: var(--transition);
  }

  .tab-btn.active {
    background: var(--gold);
    color: var(--black);
  }

  .tab-btn:hover:not(.active) {
    color: var(--gold);
    background: rgba(255,215,0,0.08);
  }

  .tab-panel { display: none; animation: fadeIn 0.3s ease; }
  .tab-panel.active { display: block; }

  .schedule-table-wrap {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--black-border);
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 580px;
  }

  .schedule-table thead { background: var(--gold); }

  .schedule-table th {
    padding: 14px 18px;
    text-align: left;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--black);
  }

  .schedule-table td {
    padding: 14px 18px;
    border-bottom: 1px solid var(--black-border);
    font-size: 0.875rem;
    color: rgba(0,0,0,0.7);
    vertical-align: middle;
    background: var(--black-card);
  }

  .schedule-table td small { display: block; color: rgba(0,0,0,0.35); font-size: 0.78rem; margin-top: 2px; }
  .schedule-table td.center { text-align: center; color: rgba(0,0,0,0.3); font-style: italic; }
  .schedule-table tr:last-child td { border-bottom: none; }
  .schedule-table tbody tr:hover td { 
    background: #1A1A00; 
    color: white;
  }
  
  .schedule-table tbody tr:hover td small,
  .schedule-table tbody tr:hover td.center { 
    color: rgba(255, 255, 255, 0.7); 
  }

  .prog-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    border-radius: 100px;
  }

  .prog-tag.mini { background: rgba(34,197,94,0.15); color: #4ade80; }
  .prog-tag.juvenil { background: rgba(0,102,204,0.15); color: #60aaff; }
  .prog-tag.elite { background: rgba(255,215,0,0.15); color: var(--gold); }
  .prog-tag.clinic { background: rgba(168,85,247,0.15); color: #c084fc; }

  .schedule-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 16px;
    background: rgba(255,215,0,0.05);
    border: 1px solid rgba(255,215,0,0.15);
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 0.85rem;
    color: rgba(0,0,0,0.45);
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .schedule-tabs { width: 100%; justify-content: center; }
    .tab-btn { padding: 10px 16px; font-size: 0.82rem; }
  }
</style>

<script>
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(target!)?.classList.add('active');
    });
  });
</script>
