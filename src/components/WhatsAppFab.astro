<div class="wa-container">
  <!-- WhatsApp Dialog -->
  <div class="wa-dialog" id="waDialog">
    <div class="wa-header">
      <div class="wa-header-info">
        <div class="wa-avatar">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#25D366">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
          </svg>
        </div>
        <div class="wa-header-text">
          <h4>Pro Skills Basketball</h4>
          <span>Normalmente responde en minutos</span>
        </div>
      </div>
      <button class="wa-close" id="waClose" aria-label="Cerrar">&times;</button>
    </div>
    
    <div class="wa-body">
      <div class="wa-info">
        <div class="info-row">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <p>Lun-Vie: 6:00 AM - 9:00 PM | Sáb: 7:00 AM - 6:00 PM</p>
        </div>
        <div class="info-row">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <p>+57 300 123 4567</p>
        </div>
        <div class="info-row">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <p>Sedes en Bogotá, Medellín y Cali</p>
        </div>
      </div>

      <div class="wa-quick">
        <strong>Mensajes rápidos:</strong>
        <button class="quick-msg">Información sobre horarios y precios</button>
        <button class="quick-msg">Quiero agendar una clase de prueba</button>
        <button class="quick-msg">Consulta sobre inscripciones</button>
        <button class="quick-msg">Información sobre sedes disponibles</button>
      </div>

      <div class="wa-form">
        <input type="text" id="waName" placeholder="Tu nombre (opcional)" />
        <textarea id="waMessage" placeholder="Escribe tu mensaje personalizado..." rows="3"></textarea>
        <button id="waSubmit" class="wa-submit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          Enviar por WhatsApp
        </button>
      </div>
    </div>
    <div class="wa-footer">Te responderemos lo antes posible</div>
  </div>

  <!-- Floating Button -->
  <button class="whatsapp-fab" id="whatsappFabBtn" aria-label="Abrir chat de WhatsApp">
    <div class="fab-pulse"></div>
    <div class="fab-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
      </svg>
    </div>
    <span class="fab-label">¿Dudas? ¡Escríbenos!</span>
  </button>
</div>

<style is:global>
  .wa-container {
    position: fixed;
    bottom: 32px;
    left: 32px; /* MOVED TO LEFT */
    z-index: 999;
  }

  /* WhatsApp Dialog Styles */
  .wa-dialog {
    position: absolute;
    bottom: 80px;
    left: 0;
    width: 340px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    overflow: hidden;
    transform-origin: bottom left;
    transform: scale(0.9);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: flex;
    flex-direction: column;
  }
  
  .wa-dialog.open {
    transform: scale(1);
    opacity: 1;
    visibility: visible;
  }

  .wa-header {
    background: #25D366;
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    color: white;
  }

  .wa-header-info {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .wa-avatar {
    width: 42px;
    height: 42px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .wa-header-text h4 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
  }

  .wa-header-text span {
    font-size: 0.75rem;
    opacity: 0.9;
  }

  .wa-close {
    background: transparent;
    border: none;
    color: white;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.8;
  }
  .wa-close:hover { opacity: 1; }

  .wa-body { padding: 16px 20px; }

  .wa-info {
    background: #F9FAFB;
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .info-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: #4B5563;
  }

  .info-row svg { flex-shrink: 0; margin-top: 2px; }
  .info-row p { margin: 0; font-size: 0.78rem; line-height: 1.4; }

  .wa-quick { margin-bottom: 16px; }
  .wa-quick strong { display: block; font-size: 0.85rem; color: #374151; margin-bottom: 8px; }

  .quick-msg {
    display: block;
    width: 100%;
    text-align: left;
    background: #F3F4F6;
    border: 1px solid #E5E7EB;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 0.8rem;
    color: #4B5563;
    margin-bottom: 6px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .quick-msg:hover { background: #E5E7EB; color: #111827; }

  .wa-form { display: flex; flex-direction: column; gap: 8px; }
  
  .wa-form input, .wa-form textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background: #F9FAFB;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: #111827;
    outline: none;
    transition: border-color 0.2s;
  }
  .wa-form input:focus, .wa-form textarea:focus { border-color: #25D366; }
  .wa-form textarea { resize: none; }

  .wa-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px;
    background: #25D366;
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 4px;
  }
  .wa-submit:hover { background: #1EBE5C; }

  .wa-footer {
    text-align: center;
    padding: 12px;
    font-size: 0.75rem;
    color: #6B7280;
    border-top: 1px solid #F3F4F6;
    background: #F9FAFB;
  }

  /* Floating Button Styles */
  .whatsapp-fab {
    display: flex;
    align-items: center;
    background: transparent;
    padding: 0;
    margin: 0;
    cursor: pointer;
    animation: fadeIn 1s 1s ease both;
  }

  .fab-pulse {
    position: absolute;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #25D366;
    opacity: 0;
    animation: pulse-ring 2s ease-out infinite;
  }

  .fab-icon {
    position: relative;
    width: 64px;
    height: 64px;
    background: #25D366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.5);
    transition: all 0.3s ease;
    flex-shrink: 0;
    z-index: 1;
  }

  .fab-label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    background: #25D366;
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 0 32px 32px 0;
    padding: 0;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    height: 64px;
    display: flex;
    align-items: center;
    margin-left: -32px;
    z-index: 0;
  }

  .whatsapp-fab:hover .fab-icon {
    transform: scale(1.1);
    box-shadow: 0 8px 32px rgba(37, 211, 102, 0.6);
    /* Switch shadow for left side */
  }

  /* Instead of growing to the left, it grows to the right now */
  .whatsapp-fab:hover .fab-label {
    max-width: 200px;
    padding: 0 20px 0 40px;
    opacity: 1;
  }

  @keyframes pulse-ring {
    0% { transform: scale(0.8); opacity: 0.6; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  @media (max-width: 480px) {
    .wa-container { bottom: 20px; left: 20px; }
    .fab-icon { width: 56px; height: 56px; }
    .fab-label { display: none; }
    .wa-dialog { width: calc(100vw - 40px); bottom: 70px; }
  }
</style>

<script>
  const fabBtn = document.getElementById('whatsappFabBtn');
  const dialog = document.getElementById('waDialog');
  const closeBtn = document.getElementById('waClose');
  const submitBtn = document.getElementById('waSubmit');
  const waName = document.getElementById('waName') as HTMLInputElement;
  const waMessage = document.getElementById('waMessage') as HTMLTextAreaElement;
  const quickMsgs = document.querySelectorAll('.quick-msg');

  // Toggle dialog
  fabBtn?.addEventListener('click', () => {
    dialog?.classList.toggle('open');
  });

  closeBtn?.addEventListener('click', () => {
    dialog?.classList.remove('open');
  });

  // Handle quick messages
  quickMsgs.forEach(msg => {
    msg.addEventListener('click', (e) => {
      const text = (e.target as HTMLElement).innerText;
      if (waMessage) waMessage.value = text;
    });
  });

  // Handle WhatsApp submit
  submitBtn?.addEventListener('click', () => {
    const phoneNumber = "573001234567";
    const name = waName?.value.trim() || "";
    let message = waMessage?.value.trim() || "Hola, quiero más información.";
    
    if (name) {
      message = `Hola, soy ${name}. ${message}`;
    }

    const url = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
    window.open(url, '_blank');
    dialog?.classList.remove('open');
    if (waMessage) waMessage.value = "";
    if (waName) waName.value = "";
  });
</script>
