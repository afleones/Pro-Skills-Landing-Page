---
---

<section class="hero" id="inicio">
  <!-- Backgrounds wrapper to hold clip-path steady while contents parallax -->
  <div class="hero-backgrounds">
    <div class="hero-bg" style="background-image: url('/psb-photo-36.jpg')"></div>
    <div class="hero-overlay"></div>

    <!-- Gold accent lines -->
    <div class="hero-lines" aria-hidden="true">
      <div class="h-line h-line-1"></div>
      <div class="h-line h-line-2"></div>
      <div class="h-circle"></div>
    </div>
  </div>

  <div class="container hero-content">
    <div class="hero-badge">🏀 Academia Profesional · Colombia</div>
    <h1 class="hero-title">
      <span class="title-sm">ELEVA TU</span>
      <span class="title-lg">JUEGO AL</span>
      <span class="title-xl">PRO <em>LEVEL</em></span>
    </h1>
    <p class="hero-desc">
      Formamos atletas de élite con metodología de talla internacional.<br />
      Entrenadores certificados · Sedes en toda Colombia · Todas las edades.
    </p>
    <div class="hero-actions">
      <a href="#contacto" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        Inscríbete Ahora
      </a>
      <a href="#programas" class="btn btn-outline">Ver Programas</a>
    </div>

    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num">+500</span>
        <span class="stat-label">Atletas Formados</span>
      </div>
      <div class="stat-div"></div>
      <div class="stat">
        <span class="stat-num">3</span>
        <span class="stat-label">Sedes Colombia</span>
      </div>
      <div class="stat-div"></div>
      <div class="stat">
        <span class="stat-num">8+</span>
        <span class="stat-label">Años Exp.</span>
      </div>
      <div class="stat-div"></div>
      <div class="stat">
        <span class="stat-num">🏆</span>
        <span class="stat-label">Campeones</span>
      </div>
    </div>
  </div>



  <div class="basketball-wrapper">
    <div class="bb-x">
      <div class="bb-incline">
        <div class="bb-bounce">
          <svg class="bb-spin" width="56" height="56" viewBox="0 0 24 24" fill="var(--gold)" stroke="#050505" stroke-width="1.2">
            <circle cx="12" cy="12" r="11" />
            <path d="M12 1v22" />
            <path d="M1 12h22" />
            <path d="M5 5c3.5 3.5 3.5 10.5 0 14" />
            <path d="M19 5c-3.5 3.5-3.5 10.5 0 14" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-backgrounds {
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 60px), 0 100%);
    z-index: 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center top;
    transform: scale(1.04);
    transition: transform 0.1s linear;
    filter: brightness(0.55);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(0,0,0,0.92) 0%,
      rgba(0,0,0,0.7) 55%,
      rgba(0, 102, 204, 0.25) 100%
    );
    z-index: 1;
  }

  .hero-lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.06;
    pointer-events: none;
  }

  .h-line {
    position: absolute;
    background: var(--proskills-gold);
  }

  .h-line-1 { width: 2px; height: 100%; left: 50%; }
  .h-line-2 { width: 100%; height: 2px; top: 50%; }

  .h-circle {
    position: absolute;
    width: min(380px, 55vw);
    height: min(380px, 55vw);
    border: 2px solid var(--proskills-gold);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 110px;
    padding-bottom: 80px;
    max-width: 720px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--proskills-gold);
    background: rgba(255, 215, 0, 0.12);
    border: 1px solid rgba(255, 215, 0, 0.35);
    padding: 8px 20px;
    border-radius: 100px;
    margin-bottom: 28px;
    animation: fadeInUp 0.7s ease forwards;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    color: white;
    line-height: 0.93;
    margin-bottom: 28px;
  }

  .title-sm {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    animation: fadeInUp 0.7s 0.1s ease both;
    opacity: 0;
    color: rgba(255,255,255,0.75);
  }

  .title-lg {
    font-size: clamp(3rem, 9vw, 7rem);
    animation: fadeInUp 0.7s 0.2s ease both;
    opacity: 0;
  }

  .title-xl {
    font-size: clamp(3.5rem, 11vw, 9rem);
    animation: fadeInUp 0.7s 0.3s ease both;
    opacity: 0;
  }

  .title-xl em {
    font-style: normal;
    color: var(--proskills-gold);
    text-shadow: 0 0 50px rgba(255,215,0,0.6);
  }

  .hero-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: rgba(255,255,255,0.72);
    max-width: 540px;
    margin-bottom: 36px;
    line-height: 1.75;
    animation: fadeInUp 0.7s 0.4s ease both;
    opacity: 0;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 52px;
    animation: fadeInUp 0.7s 0.5s ease both;
    opacity: 0;
  }

  .hero-actions .btn-outline {
    color: var(--proskills-white);
    border-color: rgba(255, 255, 255, 0.5);
  }
  
  .hero-actions .btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--proskills-white);
    border-color: var(--proskills-white);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 24px;
    animation: fadeInUp 0.7s 0.6s ease both;
    opacity: 0;
  }

  .stat { display: flex; flex-direction: column; }

  .stat-num {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--proskills-gold);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 3px;
  }

  .stat-div {
    width: 1px;
    height: 44px;
    background: rgba(255, 215, 0, 0.2);
  }



  .basketball-wrapper {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    overflow: hidden;
  }

  .bb-x {
    position: absolute;
    bottom: 0;
    right: 0;
    animation: bbMoveX 6.5s linear infinite;
  }

  .bb-incline {
    animation: bbMoveIncline 6.5s linear infinite;
  }

  .bb-bounce {
    animation: bbBounce 0.42s ease-out infinite alternate;
  }

  .bb-spin {
    display: block;
    animation: bbSpin 6.5s linear infinite;
    filter: drop-shadow(0 12px 6px rgba(0,0,0,0.4));
  }

  @keyframes bbMoveX {
    0% { transform: translateX(12vw); }
    100% { transform: translateX(-112vw); }
  }

  @keyframes bbMoveIncline {
    0% { transform: translateY(-67.2px); }
    100% { transform: translateY(7.2px); }
  }

  @keyframes bbBounce {
    0% { transform: translateY(0); }
    100% { transform: translateY(-130px); }
  }

  @keyframes bbSpin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(-720deg); }
  }

  @media (max-width: 960px) {
  }

  @media (max-width: 640px) {
    .hero-stats { gap: 16px; }
    .stat-num { font-size: 1.8rem; }
    .hero-actions { flex-direction: column; }
    .hero-actions .btn { width: 100%; justify-content: center; }
  }
</style>

<script>
  const heroBg = document.querySelector('.hero-bg') as HTMLElement;
  window.addEventListener('scroll', () => {
    if (heroBg) {
      heroBg.style.transform = `scale(1.04) translateY(${window.scrollY * 0.25}px)`;
    }
  });
</script>
