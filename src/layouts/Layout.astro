---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "PRO SKILLS BASKETBALL | Academia de Baloncesto en Colombia",
  description = "La mejor academia de baloncesto en Colombia. Entrenamientos profesionales para todas las edades. Sedes en Bogotá, Medellín y Cali.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo-shield.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content="baloncesto, academia, colombia, basketball, entrenamiento, niños, adultos, pro skills, PSB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Barlow+Condensed:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />

    <!-- Custom Cursor Follower -->
    <div id="cursor-follower" aria-hidden="true" style="position: fixed; top: 0; left: 0; width: 24px; height: 24px; pointer-events: none; z-index: 9999; transform: translate(-100px, -100px); transition: transform 0.1s cubic-bezier(0.16, 1, 0.3, 1); will-change: transform; opacity: 0.9;">
      <img src="/logo-shield.png" alt="" style="width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 3px 5px rgba(0,0,0,0.4)); display: block;" />
    </div>

    <script>
      const follower = document.getElementById('cursor-follower');
      if (follower) {
        document.addEventListener('mousemove', (e) => {
          // Adjust coordinates to place the logo slightly below and right of the native arrow cursor
          follower.style.transform = `translate(${e.clientX + 14}px, ${e.clientY + 18}px)`;
        });
      }
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    /* Pro Skills Official Brand Colors */
    --proskills-gold: #FFD700;
    --proskills-black: #000000;
    --proskills-white: #ffffff;
    --proskills-yellow: #FFFF00;
    --proskills-blue: #0066CC;
    --proskills-red: #FF0000;

    /* Semantic Mappings for LIGHT THEME */
    --gold: var(--proskills-gold);
    --gold-light: var(--proskills-yellow);
    --gold-dark: #CC9F00;
    --gold-glow: rgba(255, 215, 0, 0.35);

    /* Backgrounds: formerly dark, now light grayish white */
    --black: #F4F5F7;
    --black-mid: #F9FAFB;
    --black-soft: #FFFFFF;
    --black-card: #FFFFFF;
    --black-border: #E5E7EB;

    --yellow: var(--proskills-yellow);
    
    --blue: var(--proskills-blue);
    --blue-light: #3388DD;
    --blue-dark: #004F9E;
    --blue-glow: rgba(0, 102, 204, 0.3);

    --red: var(--proskills-red);
    --red-light: #FF3333;

    /* Text Colors: formerly light, now dark */
    --white: var(--proskills-black);
    --white-dim: rgba(0, 0, 0, 0.85);
    --white-muted: rgba(0, 0, 0, 0.6);
    --white-faint: rgba(0, 0, 0, 0.15);

    /* Typography */
    --font-body: 'Outfit', sans-serif;
    --font-heading: 'Barlow Condensed', sans-serif;

    /* Utils */
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --radius: 12px;
    --shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
    --shadow-gold: 0 4px 24px rgba(255, 215, 0, 0.2);
    --shadow-lg: 0 8px 48px rgba(0, 0, 0, 0.6);
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    background: var(--black);
    color: var(--white);
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* Custom Cursor Follower */
  .cursor-follower {
    position: fixed;
    top: 0;
    left: 0;
    width: 24px;
    height: 24px;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-100px, -100px);
    transition: transform 0.12s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    opacity: 0.95;
  }
  
  .cursor-follower img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.4));
  }
  
  /* Disable on touch screens */
  @media (pointer: coarse) {
    .cursor-follower { display: none !important; }
  }

  h1, h2, h3, h4 {
    font-family: var(--font-heading);
    line-height: 1.1;
    font-weight: 800;
  }

  img { max-width: 100%; height: auto; }

  a { text-decoration: none; color: inherit; }

  button { cursor: pointer; border: none; font-family: var(--font-body); }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--white);
  }

  .section-title span { color: var(--gold); }

  .badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gold);
    background: rgba(255, 215, 0, 0.12);
    border: 1px solid rgba(255, 215, 0, 0.3);
    padding: 6px 18px;
    border-radius: 100px;
    margin-bottom: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    transition: var(--transition);
    letter-spacing: 0.02em;
  }

  .btn-primary {
    background: var(--gold);
    color: var(--proskills-black);
    box-shadow: 0 4px 20px rgba(255, 215, 0, 0.35);
  }

  .btn-primary:hover {
    background: var(--gold-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(255, 215, 0, 0.55);
  }

  .btn-outline {
    background: transparent;
    color: var(--white);
    border: 2px solid rgba(0, 0, 0, 0.4);
  }

  .btn-outline:hover {
    background: rgba(0, 0, 0, 0.04);
    border-color: var(--gold);
    color: var(--gold-dark);
    transform: translateY(-2px);
  }

  .btn-blue {
    background: var(--blue);
    color: var(--white);
    box-shadow: 0 4px 20px rgba(0, 102, 204, 0.35);
  }

  .btn-blue:hover {
    background: var(--blue-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 102, 204, 0.5);
  }

  section { padding: 96px 0; }

  @media (max-width: 768px) { section { padding: 64px 0; } }

  /* Animations */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes pulse-ring {
    0% { transform: scale(0.8); opacity: 0.8; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  @keyframes bounce-gentle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }

  .animate-fadeInUp { animation: fadeInUp 0.7s ease forwards; }
  .delay-1 { animation-delay: 0.1s; }
  .delay-2 { animation-delay: 0.2s; }
  .delay-3 { animation-delay: 0.3s; }
  .delay-4 { animation-delay: 0.4s; }

  /* Base card style */
  .dark-card {
    background: var(--black-card);
    border: 1px solid var(--black-border);
    border-radius: 16px;
    transition: var(--transition);
  }

  .dark-card:hover {
    border-color: rgba(255, 215, 0, 0.4);
    box-shadow: 0 8px 40px rgba(255, 215, 0, 0.12);
  }
</style>
